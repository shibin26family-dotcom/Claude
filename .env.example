# Optional: without these, the app runs fully in local-only mode
# (character state is saved to the browser's localStorage instead of
# Supabase). Set both to enable persistence via Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: without this, the AI decision layer uses a built-in heuristic
# mock (no external API calls, no cost). Set this to route decisions through
# the real Claude API instead — see src/lib/game/ai.ts.
ANTHROPIC_API_KEY=
